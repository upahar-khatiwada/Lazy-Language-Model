{
  "name": "llm-developer-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "python -m http.server 3000 --bind 127.0.0.1 --directory out",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:repo": "python -B scripts/extract_repo.py",
    "verify:generated": "python -B scripts/verify_generated.py",
    "verify:content": "bun scripts/verify_content.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
