{
  "name": "llm-developer-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run sync:search && next dev",
    "build": "bun run verify:links && bun run sync:search && next build",
    "start": "python -m http.server 3000 --bind 127.0.0.1 --directory out",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:repo": "python -B scripts/extract_repo.py",
    "verify:generated": "python -B scripts/verify_generated.py",
    "verify:links": "bun scripts/verify_links.ts",
    "sync:examples": "bun scripts/sync_examples.ts",
    "verify:examples": "bun scripts/sync_examples.ts --check",
    "sync:golden": "python -B scripts/make_golden.py",
    "verify:golden": "python -B scripts/make_golden.py --check",
    "sync:derived": "python -B scripts/sync_derived.py",
    "verify:derived": "python -B scripts/sync_derived.py --check",
    "export:actual": "python -B scripts/export_actual.py",
    "verify:actual": "python -B scripts/export_actual.py --check",
    "sync:search": "bun scripts/build_search.ts",
    "sync:shapes": "python -B scripts/make_shapes.py",
    "verify:shapes": "python -B scripts/make_shapes.py --check",
    "verify:content": "bun scripts/verify_content.ts",
    "verify:site": "bun scripts/verify_site.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@vercel/analytics": "^2.0.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "katex": "0.19.1",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
